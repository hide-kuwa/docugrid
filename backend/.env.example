# Copy to .env and adjust (never commit .env)

# development | production
DOCUGRID_ENV=development

# Required in production: random string, at least 32 characters
# DOCUGRID_JWT_SECRET=change-me-to-a-long-random-string

# Required in production: used to encrypt AI provider keys and SPI (My Number) vault at rest
# DOCUGRID_SECRET_ENCRYPTION_KEY=change-me-to-a-different-long-random-string
# SPI uses a purpose-derived key from this secret (see docs/my-number-handling.md)

# Default true in development, false in production unless explicitly set
# DOCUGRID_ALLOW_HEADER_AUTH=true

# Google Sign-In (OAuth 2.0) — primary login in production
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:3000 (and your production URL)
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
#
# Drive 連携（事務所の「Google で接続」）— 同じクライアントにシークレットを発行し、
# 承認済みリダイレクト URI に次を追加:
#   http://localhost:8000/api/drive/oauth/callback
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8000/api/drive/oauth/callback
# （任意）別クライアントを使う場合: GOOGLE_DRIVE_OAUTH_CLIENT_ID / GOOGLE_DRIVE_OAUTH_CLIENT_SECRET

# Dev-only password login (disabled automatically in production)
# DOCUGRID_ALLOW_PASSWORD_LOGIN=true
# DOCUGRID_LOGIN_PASSWORD=password

# Optional
# DOCUGRID_JWT_EXP_HOURS=24
# Platform super-admin (dev default admin@taxx.jp). Comma-separated for Google + password.
# DOCUGRID_SUPER_ADMIN_EMAIL=admin@taxx.jp,you@gmail.com
# DOCUGRID_SUPER_ADMIN_EMAIL=
# DOCUGRID_CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
# パートナー別公開のフロント URL もカンマ区切りで追加（例: https://sim.partner.example.com）

# Stripe billing (事務所サブスクリプション + Connect + AI 従量)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_FIRM_BASE=price_...          # 基本料 1万円/月
# STRIPE_PRICE_CLIENT_METERED=price_...     # 顧問先 300円/社/月（従量・Meter 連携）
# STRIPE_METER_CLIENT_EVENT=docugrid_billable_clients
# STRIPE_PRICE_AI_TOPUP_100=price_...       # AI 100円パック（任意・未設定時は動的 price_data）
# BILLING_FIRM_BASE_YEN=10000
# BILLING_FIRM_PER_CLIENT_YEN=300
# BILLING_PARTNER_COMMISSION_PERCENT=20
# PROLEXT 無料枠: 既定は lext-tax.com,lext-tax.jp,prolext.jp / firm_prolext
# DOCUGRID_BILLING_FREE_EMAIL_DOMAINS=lext-tax.com,lext-tax.jp,prolext.jp
# DOCUGRID_BILLING_FREE_FIRM_IDS=firm_prolext
# AI_INCLUDED_TOKENS_PER_CLIENT_MONTH=25000
# MIGRATION_INCLUDED_TOKENS=200000
# 初回整理パック価格（円）— 1 パックあたり付与トークンは MIGRATION_TOKENS_PER_100_YEN と連動
# MIGRATION_YEN_PER_PACK=10000
# MIGRATION_TOKENS_PER_100_YEN=10000
# ZIP 見積: PDF 1 件あたりの想定トークン（中央値）
# MIGRATION_GLOBAL_LEARNING_FIRM_ID=firm_prolext
# MIGRATION_GLOBAL_LEARNING_FIRM_IDS=firm_prolext
# AI_TOKENS_PER_100_YEN=10000
# DOCUGRID_FRONTEND_URL=http://localhost:3000
# DOCUGRID_CSRF=true
# DOCUGRID_MCP_JWT_EXP_HOURS=1
# DOCUGRID_MCP_TOKEN_RATE_LIMIT=10

# Moneytree LINK（銀行・クレカ連携）— 契約後にマネーツリーから client_id を取得
# MONEYTREE_LINK_CLIENT_ID=
# MONEYTREE_LINK_CLIENT_SECRET=
# MONEYTREE_LINK_REDIRECT_URI=http://localhost:8000/api/integrations/moneytree/callback
# MONEYTREE_LINK_ENV=staging
# MONEYTREE_LINK_MOCK=true

# Support assistant (S2/S3) — help chat + CS tickets
# OPENAI_API_KEY=           # optional: nicer phrasing for /api/support/chat
# DOCUGRID_SUPPORT_MODEL=gpt-4o-mini
# DOCUGRID_SUPPORT_INBOX_EMAIL=support@example.com
# DOCUGRID_SUPPORT_SMTP_HOST=
# DOCUGRID_SUPPORT_SMTP_PORT=587
# DOCUGRID_SUPPORT_SMTP_USER=
# DOCUGRID_SUPPORT_SMTP_PASSWORD=
# DOCUGRID_SUPPORT_SMTP_FROM=
# DOCUGRID_SUPPORT_SMTP_TLS=1

# --- Production template (copy to .env.production) ---
# See .env.production.example and docs/production-deployment.md
