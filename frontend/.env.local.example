# 未設定ならブラウザのホスト名:8000 に自動接続（社内 LAN 共有向け）。
# この PC だけ使う場合は下を有効化:
# NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# 役員報酬シミュレーター — パートナー別公開（任意）
# NEXT_PUBLIC_EXEC_COMP_PARTNER_DOMAINS=sim.partner.example.com
# NEXT_PUBLIC_EXEC_COMP_PARTNER_NAME=〇〇税理士法人
# NEXT_PUBLIC_EXEC_COMP_PARTNER_SITE_URL=https://partner.example.com
# NEXT_PUBLIC_EXEC_COMP_POWERED_BY_URL=https://taxx.jp
# 専用ページ: /sim/officer-comp（パートナードメインは middleware でルートに表示）

# 同じ Wi-Fi の他 PC から使う: リポジトリ直下で `npm run dev:lan`

# Must match backend GOOGLE_OAUTH_CLIENT_ID (Web client ID from Google Cloud Console)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Drive「Google で接続」はバックエンド側: GOOGLE_OAUTH_CLIENT_SECRET +
# リダイレクト URI http://localhost:8000/api/drive/oauth/callback

# Stripe (Checkout redirect only — keys live on backend)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
