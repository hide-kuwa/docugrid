# Copy to .env.production.local on Vercel / hosting provider — never commit.
# Build-time variables for Next.js production frontend.

NEXT_PUBLIC_API_BASE=https://api.example.com/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 役員報酬シミュレーター — パートナー別ドメイン（Vercel に同一プロジェクトでドメイン追加）
# NEXT_PUBLIC_EXEC_COMP_PARTNER_DOMAINS=sim.partner.example.com
# NEXT_PUBLIC_EXEC_COMP_PARTNER_NAME=〇〇税理士法人
# NEXT_PUBLIC_EXEC_COMP_PARTNER_SITE_URL=https://partner.example.com
# NEXT_PUBLIC_EXEC_COMP_POWERED_BY_URL=https://taxx.jp
# バックエンド DOCUGRID_CORS_ORIGINS にパートナー URL（https://sim.partner.example.com）も追加

# Phase 5 — Stripe Checkout redirect (publishable key only; secret stays on API)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
